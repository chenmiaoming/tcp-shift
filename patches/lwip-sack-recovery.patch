+  struct tcp_seg **link;
+  struct tcp_seg **cur_seg;
+  u32_t seq;
+  err_t err;
+
+  if (start_seq != NULL) {
+    *start_seq = 0U;
+  }
+  if (end_seq != NULL) {
+    *end_seq = 0U;
+  }
+  if (is_retransmission != NULL) {
+    *is_retransmission = 0U;
+  }
+  if (pcb == NULL) {
+    return ERR_VAL;
+  }
+
+  /* RFC 8985 section 7.3 prefers one segment of new data, even one packet
+     beyond cwnd, when the receive window permits it. */
+  err = tcp_shift_tcp_tlp_send_new_data(pcb, start_seq, end_seq);
+  if (err == ERR_OK) {
+    return ERR_OK;
+  }
+  if (err != ERR_VAL) {
+    return err;
+  }
+  if (pcb->unacked == NULL) {
+    return ERR_VAL;
+  }
+
+  /* With no eligible new data, retransmit the highest-sequence segment. */
+  link = &pcb->unacked;
+  seg = pcb->unacked;
+  while (seg->next != NULL) {
+    link = &seg->next;
+    seg = seg->next;
+  }
+  if (tcp_output_segment_busy(seg)) {
+    return ERR_VAL;
+  }
+
+  seq = lwip_ntohl(seg->tcphdr->seqno);
+  if (start_seq != NULL) {
+    *start_seq = seq;
+  }
+  if (end_seq != NULL) {
+    *end_seq = seq + TCP_TCPLEN(seg);
+  }
+  if (is_retransmission != NULL) {
+    *is_retransmission = 1U;
+  }
+
+  *link = seg->next;
+  cur_seg = &pcb->unsent;
+  while (*cur_seg &&
+         TCP_SEQ_LT(lwip_ntohl((*cur_seg)->tcphdr->seqno), seq)) {
+    cur_seg = &((*cur_seg)->next);
+  }
+  seg->next = *cur_seg;
+  *cur_seg = seg;
+  seg->flags |= TCP_SHIFT_TF_SEG_SACK_REXMIT;
+#if TCP_OVERSIZE
+  if (seg->next == NULL) {
+    pcb->unsent_oversize = 0;
+  }
+#endif
+  pcb->rttest = 0;
+  pcb->rtime = 0;
+  MIB2_STATS_INC(mib2.tcpretranssegs);
+  err = tcp_output(pcb);
+  return err;
+}
+#endif /* TCP_SHIFT_EXPERIMENTAL_RACK_TLP */
+#endif /* LWIP_TCP_SACK_OUT && selective recovery */
