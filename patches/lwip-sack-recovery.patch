+#if LWIP_TCP_SACK_OUT
+err_t
+tcp_shift_tcp_rexmit_sack_hole(struct tcp_pcb *pcb)
+{
+  struct tcp_seg *seg;
+  struct tcp_seg **unacked_link;
+  struct tcp_seg **cur_seg;
+  u16_t sacked_after = 0U;
+
+  if (pcb == NULL || (pcb->flags & TF_SACK) == 0U ||
+      pcb->unacked == NULL) {
+    return ERR_VAL;
+  }
+
+  for (seg = pcb->unacked; seg != NULL; seg = seg->next) {
+    if ((seg->flags & TCP_SHIFT_TF_SEG_SACKED) != 0U &&
+        sacked_after != 0xFFFFU) {
+      sacked_after++;
+    }
+  }
+  if (sacked_after < 3U) {
+    return ERR_VAL;
+  }
+
+  unacked_link = &pcb->unacked;
+  for (seg = pcb->unacked; seg != NULL; seg = seg->next) {
+    if ((seg->flags & TCP_SHIFT_TF_SEG_SACKED) != 0U) {
+      if (sacked_after != 0U) {
+        sacked_after--;
+      }
+      unacked_link = &seg->next;
+      continue;
+    }
+    if ((seg->flags & TCP_SHIFT_TF_SEG_SACK_REXMIT) != 0U ||
+        sacked_after < 3U) {
+      unacked_link = &seg->next;
+      continue;
+    }
+    if (tcp_output_segment_busy(seg)) {
+      return ERR_VAL;
+    }
+
+    *unacked_link = seg->next;
+    cur_seg = &pcb->unsent;
+    while (*cur_seg &&
+           TCP_SEQ_LT(lwip_ntohl((*cur_seg)->tcphdr->seqno),
+                      lwip_ntohl(seg->tcphdr->seqno))) {
+      cur_seg = &((*cur_seg)->next);
+    }
+    seg->next = *cur_seg;
+    *cur_seg = seg;
+    seg->flags |= TCP_SHIFT_TF_SEG_SACK_REXMIT;
+#if TCP_OVERSIZE
+    if (seg->next == NULL) {
+      pcb->unsent_oversize = 0;
+    }
+#endif
+    if (pcb->nrtx < 0xFF) {
+      ++pcb->nrtx;
+    }
+    pcb->rttest = 0;
+    MIB2_STATS_INC(mib2.tcpretranssegs);
+    return ERR_OK;
+  }
+  return ERR_VAL;
+}
+#endif /* LWIP_TCP_SACK_OUT */
