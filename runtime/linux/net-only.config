# tcp-shift Linux TCP runtime configuration intent.
#
# This is a Kconfig fragment, not yet a complete standalone .config. The
# architecture port will merge it on top of a minimal arch configuration and
# let olddefconfig resolve the generic kernel dependency closure.

CONFIG_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_HIGH_RES_TIMERS=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Use a software virtual netdevice for the first prototype. The exact device
# can later be replaced by a tcp-shift-specific host queue driver.
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# Deliberately outside the v0 scope.
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_MODULES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_PCI is not set
# CONFIG_BLOCK is not set
# CONFIG_EXT4_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_VFAT_FS is not set
